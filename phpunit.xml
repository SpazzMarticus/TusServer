<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd" colors="true" executionOrder="random">
  <coverage>
    <report>
      <html outputDirectory=".code-coverage" lowUpperBound="35" highLowerBound="70"/>
    </report>
  </coverage>
  <source>
    <include>
      <directory>src/</directory>
    </include>
  </source>
  <testsuites>
    <testsuite name="unit">
      <directory>tests/phpunit/unit/</directory>
    </testsuite>
    <testsuite name="integration">
      <directory>tests/phpunit/integration/</directory>
    </testsuite>
  </testsuites>
</phpunit>
